# Environment-variable template only; never commit real credentials.

# Resend Email Integration
RESEND_API_KEY=re_123456789
EMAIL_FROM=Majedaar Restaurant <onboarding@resend.dev>

# Web Push VAPID Configuration
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@majedaar.com

# Google Maps API (Optional server-side key for distance or geocoding services)
GOOGLE_MAPS_API_KEY=your_server_google_maps_api_key_here

# Google OAuth 2.0 Credentials
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Application type: Web application
# Add Authorized JavaScript Origins: http://localhost:3000, https://yourdomain.com
# GOOGLE_CLIENT_SECRET must only be set on the backend — never expose it to the frontend.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
