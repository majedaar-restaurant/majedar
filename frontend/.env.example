# Majedaar Restaurant Frontend Environment Configuration Template
# Do not commit real credentials to version control.

# Backend API Base URL (Express backend)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google Maps JavaScript & Places API Key (Browser-restricted key)
# Requires Maps JavaScript API, Places API, and Geocoding API enabled in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
